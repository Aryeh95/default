	(label "+3V3" (at 364.49 85.09 90) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ddb79015-27af-5b56-8bf5-4f78de22774a"))
	(label "GND" (at 364.49 92.71 270) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "50bffde1-65d8-5d5b-b51b-9f72fa8a5f11"))
	(text "Notes" (exclude_from_sim no) (at 25 330.00 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "adefde2d-ff5a-53ca-8a5e-cda5d4ff85e1"))
	(text "1. Charger: any USB-C PD charger of 30 W or more (15 V is mandatory above 27 W)." (exclude_from_sim no) (at 25 335.50 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "dc2e4e5b-6f4d-577e-9e62-1f99cdea39ef"))
	(text "2. U1 can also be a CH224K: then R1 = 1k (1206), R16 = 10k, same 56k on CFG1." (exclude_from_sim no) (at 25 341.00 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "91cf2747-c75b-5e97-89d4-02917866b64f"))
	(text "3. Fan PWM is open-collector through Q3, so the firmware output is inverted." (exclude_from_sim no) (at 25 346.50 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "053f4c50-7066-51ef-97ca-b5104343ec80"))
	(text "4. FAN_EN low or floating keeps the 12 V rail off (R6 pull-down)." (exclude_from_sim no) (at 25 352.00 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "3089b3e8-f658-579b-8240-cc04ea582bfe"))
	(text "5. PD_PG is open drain: enable the MCU's internal pull-up in firmware." (exclude_from_sim no) (at 25 357.50 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "a7bc0456-6443-55e4-ae05-4278347f6158"))
	(text "6. Tach inputs: 10k pull-up to 3V3 and 10k series resistor (protects against fans that pull tach to 12 V)." (exclude_from_sim no) (at 25 363.00 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "c55320e3-3cbb-52b6-9428-aa90d2edea4a"))
	(text "7. J2, J3 (and J4, J5 if used) are hand-soldered through-hole headers." (exclude_from_sim no) (at 25 368.50 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "b127f5a1-beab-5413-bb04-a2670c729825"))
	(text "8. Flash the XIAO through its own USB-C port. D1 stops it back-feeding the board's 5 V rail." (exclude_from_sim no) (at 25 374.00 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "fd70c349-e413-5f89-948a-4d629c59a87c"))
	(sheet_instances (path "/" (page "1")))
	(embedded_fonts no)
)
