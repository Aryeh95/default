	(text "Notes" (exclude_from_sim no) (at 280 250.00 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left bottom)) (uuid "4784be74-fb30-56f5-9ee1-28880f07f584"))
	(text "1. Charger: any USB-C PD charger of 30 W or more (15 V is mandatory above 27 W)." (exclude_from_sim no) (at 280 254.50 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "14bafed9-e16d-5e8f-ae8e-d281a2fcc458"))
	(text "2. U1 can also be a CH224K: then R1 = 1k (1206), R16 = 10k, same 56k on CFG1." (exclude_from_sim no) (at 280 259.00 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c675330a-13ce-5fb6-8159-8d807d1a03df"))
	(text "3. U2: 7805-pinout switching module (K7805-500R3 or similar), not a linear 7805." (exclude_from_sim no) (at 280 263.50 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "46c24628-bff9-53c3-b517-588eae670faa"))
	(text "4. Fan PWM is open-collector through Q3, so the firmware output is inverted." (exclude_from_sim no) (at 280 268.00 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a33c3e83-5f9a-5d74-8f93-04e2d9fdb526"))
	(text "5. FAN_EN low or floating keeps the 12 V rail off (R6 pull-down)." (exclude_from_sim no) (at 280 272.50 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "7453ff3d-67a2-507e-a0f8-cfd9acdc3153"))
	(sheet_instances (path "/" (page "1")))
	(embedded_fonts no)
)
